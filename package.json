{
  "name": "para",
  "version": "1.0.0",
  "description": "Private browser-only paragliding flight replay and weather decision aid",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-cesium.mjs && vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/copy-cesium.mjs && npm run typecheck && vite build",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "check:privacy": "node scripts/check-dist-privacy.mjs"
  },
  "dependencies": {
    "cesium": "1.144.0",
    "igc-parser": "2.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
